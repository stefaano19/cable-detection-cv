    "            ax3.imshow(zoom)\n",
    "            ax3.set_title(\"Best pair\")\n",
    "            ax3.axis(\"off\")\n",
    "\n",
    "            theta_fit, skel, skel_len, n_comp, thickness, bbox, diag = theta_from_mask(pm)\n",
    "            if skel is not None and skel_len > 0:\n",
    "                ys, xs = np.where(skel > 0)\n",
    "                ax3.scatter(xs, ys, s=1, c=\"yellow\", alpha=0.6)\n",
    "\n",
    "            if pred_obj is not None and \"lines\" in pred_obj and len(pred_obj[\"lines\"]) == 2:\n",
    "                rho, theta = float(pred_obj[\"lines\"][0]), float(pred_obj[\"lines\"][1])\n",
    "                pts = line_border_points_from_polar(rho, theta, W, H)\n",
    "                if pts is not None:\n",
    "                    (x1, y1), (x2, y2) = pts\n",
    "                    ax3.plot([x1, x2], [y1, y2], linewidth=2)\n",
    "\n",
    "        txt = []\n",
    "        txt.append(f\"n_gt={r['n_gt']} | n_pred={r['n_pred']} | best_iou={r['best_iou']:.3f}\")\n",
    "        if r[\"edge_density\"] is not None:\n",
    "            txt.append(f\"edge_density={r['edge_density']:.4f}\")\n",
    "        txt.append(f\"max_score={r['max_score']:.3f} | mean_score={r['mean_score']:.3f} | max_pred_overlap={r['max_pred_overlap']:.3f}\")\n",
    "\n",
    "        if rep is not None:\n",
    "            txt.append(\n",
    "                f\"[BestPair] iou={rep['iou']:.3f} | score={rep['pred_score']:.3f} | \"\n",
    "                f\"skel_len={rep['skel_len']} | n_comp={rep['n_comp']} | thickness={rep['thickness']:.2f}\"\n",
    "            )\n",
    "            if rep[\"dtheta_raw\"] is not None:\n",
    "                txt.append(f\"Δθ={rep['dtheta_raw']:.3f} rad | exp={rep['theta_exp']:.3f}\")\n",
    "\n",
    "        plt.figtext(0.01, 0.01, \"\\n\".join(txt), ha=\"left\", fontsize=10)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "        # FP analysis (opzionale)\n",
    "        if print_fp_analysis and r[\"n_gt\"] == 0 and r[\"n_pred\"] > 0:\n",
    "            print(\"🚫 FP analysis (empty GT):\")\n",
    "            idxs = np.argsort([-float(p.get(\"score\",0.0)) for p in r[\"pred_objs\"]]).tolist()\n",
    "            for pi in idxs[:min(3, len(idxs))]:   # ✅ ancora più leggero (3 max)\n",
    "                p = r[\"pred_objs\"][pi]\n",
    "                pm = r[\"pred_masks\"][pi]\n",
    "                info = explain_fp_filtering(p, pm, best_cfg=best_cfg)\n",
    "                print(f\"  pred#{pi} score={float(p.get('score',0.0)):.3f} | area={info['area']} | skel_len={info['skel_len']} | n_comp={info['n_comp']} | thickness={info['thickness']:.2f}\")\n",
    "                if info[\"reasons\"]:\n",
    "                    print(\"    -> Bocciato da:\", \", \".join(info[\"reasons\"]))\n",
    "            print()\n",
    "\n",
    "    # ============================================================\n",
    "    # Render limitato (ANTI-BLACKOUT)\n",
    "    # ============================================================\n",
    "    shown = 0\n",
    "\n",
    "    def safe_show(r, title):\n",
    "        nonlocal shown\n",
    "        if shown >= int(max_total_show):\n",
    "            return False\n",
    "        show_record(r, title)\n",
    "        plt.close(\"all\")  # ✅ fondamentale\n",
    "        shown += 1\n",
    "        return True\n",
    "\n",
    "    if \"easy\" in show_groups:\n",
    "        print(\"\\n==================== ✅ CASI FACILI ====================\")\n",
    "        for r in easy:\n",
    "            if not safe_show(r, \"✅ Caso facile: cavo isolato, continuità buona, θ stabile\"):\n",
    "                break\n",
    "\n",
    "    if shown < max_total_show and \"hard\" in show_groups:\n",
    "        print(\"\\n==================== ⚠️ CASI DIFFICILI ====================\")\n",
    "        for r in hard:\n",
    "            if not safe_show(r, \"⚠️ Caso difficile: occlusioni / background complesso → dove fallisce la mask?\"):\n",
    "                break\n",
    "\n",
    "    if shown < max_total_show and \"blob\" in show_groups:\n",
    "        print(\"\\n==================== ❌ ERRORI TIPICI ====================\")\n",
    "        for r in blob:\n",
    "            if not safe_show(r, \"❌ Errore tipico: blob spesso o spezzato → ritocca soglie / thinning / split blob\"):\n",
    "                break\n",
    "\n",
    "    if shown < max_total_show and \"fp\" in show_groups:\n",
    "        print(\"\\n==================== 🚫 FALSI POSITIVI ====================\")\n",
    "        for r in fp:\n",
    "            if not safe_show(r, \"🚫 Esempio FP: empty GT → come filtrarlo (empty penalty / area / skel_len / NMS)\"):\n",
    "                break\n",
    "\n",
    "    return lds, {\"easy\": easy, \"hard\": hard, \"blob\": blob, \"fp\": fp, \"rows\": rows}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# USO CONSIGLIATO (pochissime immagini)\n",
    "# ============================================================\n",
    "\n",
    "lds, pack = visualize_lds_debug_cases(\n",
