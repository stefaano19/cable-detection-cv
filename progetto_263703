    "    best_cfg=BEST_CFG,\n",
    "    n_each=2,                 \n",
    "    max_images=300,           \n",
    "    max_total_show=8,         \n",
    "    show_groups=(\"easy\",\"hard\", \"blob\", \"fp\"), \n",
    "    print_fp_analysis=False    \n",
    ")\n"
   ]
