    "IMG_SIZE_TRAIN = 896\n",
    "IMG_SIZE_VALIDATION = 1024\n",
    "\n",
    "def get_training_augmentation(img_size: int = IMG_SIZE_TRAIN):\n",
    "    return A.Compose([\n",
    "        A.PadIfNeeded(\n",
    "            min_height=img_size, min_width=img_size,\n",
    "            border_mode=cv2.BORDER_CONSTANT, value=0, mask_value=0,\n",
    "            always_apply=True\n",
    "        ),\n",
    "        A.OneOf([\n",
    "            A.CropNonEmptyMaskIfExists(height=img_size, width=img_size, p=1.0),\n",
    "            A.RandomCrop(height=img_size, width=img_size, p=1.0),\n",
    "        ], p=1.0),\n",
    "\n",
    "        A.Affine(\n",
    "            scale=(0.80, 1.25),\n",
    "            rotate=(-25, 25),\n",
    "            translate_percent=(0.08, 0.08),\n",
    "            shear=(-8, 8),\n",
    "            p=0.75,\n",
    "            interpolation=cv2.INTER_LINEAR,\n",
    "            mask_interpolation=cv2.INTER_NEAREST,\n",
    "        ),\n",
    "        A.HorizontalFlip(p=0.5),\n",
    "        A.VerticalFlip(p=0.2),\n",
    "\n",
    "        A.OneOf([\n",
    "            A.RandomBrightnessContrast(p=1.0),\n",
    "            A.CLAHE(p=1.0),\n",
    "        ], p=0.30),\n",
    "        A.RandomGamma(gamma_limit=(85, 120), p=0.15),\n",
    "\n",
    "        A.OneOf([\n",
    "            A.GaussianBlur(blur_limit=(3, 7), p=1.0),\n",
    "            A.MotionBlur(blur_limit=(3, 9), p=1.0),\n",
    "        ], p=0.25),\n",
    "\n",
    "        A.ImageCompression(quality_lower=70, quality_upper=95, p=0.10),\n",
    "\n",
    "        A.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                    std=[0.229, 0.224, 0.225]),\n",
    "    ])\n",
    "\n",
    "def get_test_augmentation(sz: int = IMG_SIZE_VALIDATION):\n",
    "    return A.Compose([\n",
    "        A.Resize(height=sz, width=sz, interpolation=cv2.INTER_LINEAR),\n",
    "        A.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                    std=[0.229, 0.224, 0.225]),\n",
    "    ])\n"
