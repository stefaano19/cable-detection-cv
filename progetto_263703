    "torch.backends.cudnn.benchmark = True\n",
    "torch.backends.cuda.matmul.allow_tf32 = True\n",
    "torch.backends.cudnn.allow_tf32 = True\n",
    "try:\n",
    "    torch.set_float32_matmul_precision(\"high\")\n",
    "except Exception:\n",
    "    pass\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "use_amp = (device.type == \"cuda\")\n",
    "\n",
    "# =========================\n",
    "# CONFIG\n",
    "# =========================\n",
    "CKPT_DIR = \"/kaggle/working/weights\"\n",
    "os.makedirs(CKPT_DIR, exist_ok=True)\n",
    "\n",
    "BATCH_SIZE = 1\n",
    "CACHE_IMAGES = False\n",
    "CACHE_MASKS = True\n",
    "CABLE_CATEGORY_ID = 0\n",
    "\n",
    "# =========================\n",
    "# HELPERS\n",
    "# =========================\n",
    "def seed_worker(worker_id: int):\n",
    "    worker_seed = torch.initial_seed() % 2**32\n",
    "    np.random.seed(worker_seed)\n",
    "    random.seed(worker_seed)\n",
    "\n",
    "def infer_category_id_from_coco(coco_json_path: str) -> int:\n",
    "    with open(coco_json_path, \"r\") as f:\n",
    "        coco = json.load(f)\n",
    "    if \"categories\" in coco and len(coco[\"categories\"]) > 0:\n",
    "        return int(coco[\"categories\"][0][\"id\"])\n",
    "    cats = [int(a[\"category_id\"]) for a in coco.get(\"annotations\", []) if \"category_id\" in a]\n",
    "    return int(max(set(cats), key=cats.count)) if cats else 0\n",
    "\n",
    "def _decode_segmentation(seg, h: int, w: int):\n",
    "    if isinstance(seg, dict) and \"counts\" in seg:\n",
    "        m = maskUtils.decode(seg)\n",
    "    else:\n",
    "        rles = maskUtils.frPyObjects(seg, h, w)\n",
    "        m = maskUtils.decode(rles)\n",
    "    if m.ndim == 3:\n",
    "        m = np.max(m, axis=2)\n",
    "    return m\n",
    "\n",
    "# =========================\n",
    "# DATASET\n",
    "# =========================\n",
    "class CableSegmentationDataset(Dataset):\n",
    "    def __init__(\n",
    "        self,\n",
    "        data_path,\n",
    "        json_file,\n",
    "        image_dir=\"\",\n",
    "        transform=None,\n",
    "        is_test=False,\n",
    "        cache_in_ram=False,\n",
    "        cache_masks_in_ram=False,\n",
    "        target_category_id: int | None = None,\n",
    "    ):\n",
    "        self.data_path = str(data_path)\n",
    "        self.image_dir = os.path.join(self.data_path, image_dir) if image_dir else self.data_path\n",
    "        self.transform = transform\n",
    "        self.is_test = is_test\n",
    "\n",
    "        coco_path = os.path.join(self.data_path, str(json_file)) if not str(json_file).startswith(self.data_path) else str(json_file)\n",
    "        with open(coco_path, \"r\") as f:\n",
    "            self.coco_data = json.load(f)\n",
    "\n",
    "        if target_category_id is None and (not self.is_test):\n",
    "            target_category_id = infer_category_id_from_coco(coco_path)\n",
    "        self.target_category_id = target_category_id\n",
    "\n",
    "        self.images = {int(img[\"id\"]): img for img in self.coco_data[\"images\"]}\n",
    "        self.items_to_load = list(self.images.values())\n",
    "\n",
    "        self.img_to_anns = defaultdict(list)\n",
    "        if not self.is_test:\n",
    "            for ann in self.coco_data.get(\"annotations\", []):\n",
    "                if int(ann.get(\"category_id\", -999)) == int(self.target_category_id):\n",
    "                    self.img_to_anns[int(ann[\"image_id\"])].append(ann)\n",
    "\n",
    "        self.cached_images = {}\n",
    "        self.cached_masks = {}\n",
    "\n",
    "        if cache_in_ram:\n",
    "            for img_info in tqdm(self.items_to_load, desc=\"Caching images\"):\n",
    "                img_id = int(img_info[\"id\"])\n",
    "                path = os.path.join(self.image_dir, img_info[\"file_name\"])\n",
    "                img = cv2.imread(path)\n",
    "                if img is not None:\n",
    "                    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "                    self.cached_images[img_id] = img\n",
    "\n",
    "        if cache_masks_in_ram and (not self.is_test):\n",
    "            for img_info in tqdm(self.items_to_load, desc=\"Caching masks\"):\n",
    "                img_id = int(img_info[\"id\"])\n",
    "                h = int(img_info.get(\"height\", 0))\n",
    "                w = int(img_info.get(\"width\", 0))\n",
    "                if h <= 0 or w <= 0:\n",
    "                    path = os.path.join(self.image_dir, img_info[\"file_name\"])\n",
    "                    tmp = cv2.imread(path)\n",
    "                    if tmp is None:\n",
    "                        continue\n",
    "                    h, w = tmp.shape[:2]\n",
    "\n",
    "                mask = np.zeros((h, w), dtype=np.uint8)\n",
    "                for ann in self.img_to_anns.get(img_id, []):\n",
    "                    m = _decode_segmentation(ann[\"segmentation\"], h, w)\n",
    "                    mask = np.maximum(mask, m.astype(np.uint8))\n",
    "                self.cached_masks[img_id] = (mask > 0).astype(np.uint8)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.items_to_load)\n",
    "\n",
    "    def __getitem__(self, idx: int):\n",
    "        image_info = self.items_to_load[idx]\n",
    "        img_id = int(image_info[\"id\"])\n",
    "\n",
    "        if img_id in self.cached_images:\n",
    "            image = self.cached_images[img_id].copy()\n",
    "        else:\n",
    "            path = os.path.join(self.image_dir, image_info[\"file_name\"])\n",
    "            image = cv2.imread(path)\n",
    "            if image is None:\n",
    "                raise RuntimeError(f\"Cannot read image {img_id}: {path}\")\n",
    "            image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "        h, w = image.shape[:2]\n",
    "\n",
    "        if self.is_test:\n",
    "            if self.transform:\n",
    "                image = self.transform(image=image)[\"image\"]\n",
    "            image_tensor = torch.from_numpy(image).permute(2, 0, 1).float().contiguous()\n",
    "            return image_tensor, img_id\n",
    "\n",
    "        if img_id in self.cached_masks:\n",
    "            mask = self.cached_masks[img_id].copy().astype(np.float32)\n",
    "        else:\n",
    "            mask = np.zeros((h, w), dtype=np.float32)\n",
    "            for ann in self.img_to_anns.get(img_id, []):\n",
    "                m = _decode_segmentation(ann[\"segmentation\"], h, w)\n",
    "                mask = np.maximum(mask, m.astype(np.float32))\n",
    "            mask = np.clip(mask, 0.0, 1.0)\n",
    "\n",
    "        if self.transform:\n",
    "            tr = self.transform(image=image, mask=mask)\n",
    "            image, mask = tr[\"image\"], tr[\"mask\"]\n",
    "\n",
    "        mask = (mask > 0.5).astype(np.float32)\n",
    "\n",
    "        image_tensor = torch.from_numpy(image).permute(2, 0, 1).float().contiguous()\n",
    "        mask_tensor = torch.from_numpy(mask).unsqueeze(0).float().contiguous()\n",
    "        return image_tensor, mask_tensor\n",
    "\n",
    "# =========================\n",
    "# DATASETS / LOADERS\n",
    "# =========================\n",
    "train_dataset = CableSegmentationDataset(\n",
    "    data_path=TRAIN_DIR,\n",
    "    json_file=TRAIN_JSON,\n",
    "    image_dir=IMAGE_SUBDIR,\n",
    "    transform=get_training_augmentation(),\n",
    "    is_test=False,\n",
    "    cache_in_ram=CACHE_IMAGES,\n",
    "    cache_masks_in_ram=CACHE_MASKS,\n",
    "    target_category_id=CABLE_CATEGORY_ID,\n",
    ")\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=True,\n",
    "    num_workers=0,\n",
    "    pin_memory=True,\n",
    "    persistent_workers=False,\n",
    ")\n",
    "\n",
    "test_dataset = CableSegmentationDataset(\n",
    "    data_path=TEST_DIR,\n",
    "    json_file=TEST_JSON,\n",
    "    image_dir=IMAGE_SUBDIR,\n",
    "    transform=get_test_augmentation(),\n",
    "    is_test=True,\n",
    "    cache_in_ram=False,\n",
    "    cache_masks_in_ram=False,\n",
    "    target_category_id=None,\n",
    ")\n",
    "\n",
    "test_loader = DataLoader(\n",
    "    test_dataset,\n",
    "    batch_size=1,\n",
    "    shuffle=False,\n",
    "    num_workers=0,\n",
    "    pin_memory=True,\n",
    "    persistent_workers=False,\n",
    ")\n",
    "\n",
    "print(\"Train images:\", len(train_dataset))\n",
    "print(\"Test images :\", len(test_dataset))\n"
   ]
