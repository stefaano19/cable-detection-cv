    "# =========================\n",
    "# clDice helpers + CableLoss (tutto insieme)\n",
    "# =========================\n",
    "\n",
    "\n",
    "\n",
    "def soft_erode(img):\n",
    "    p1 = -F.max_pool2d(-img, (3, 1), 1, (1, 0))\n",
    "    p2 = -F.max_pool2d(-img, (1, 3), 1, (0, 1))\n",
    "    return torch.min(p1, p2)\n",
    "\n",
    "def soft_dilate(img):\n",
    "    return F.max_pool2d(img, (3, 3), 1, 1)\n",
    "\n",
    "def soft_open(img):\n",
    "    return soft_dilate(soft_erode(img))\n",
    "\n",
    "def soft_skel(img, iters=10):\n",
    "    img = img.clamp(0, 1)\n",
    "    skel = torch.zeros_like(img)\n",
    "    for _ in range(int(iters)):\n",
    "        opened = soft_open(img)\n",
    "        delta = F.relu(img - opened)\n",
    "        skel = skel + F.relu(delta - skel * delta)\n",
    "        img = soft_erode(img)\n",
    "    return skel.clamp(0, 1)\n",
    "\n",
    "def cldice_loss(prob, gt, iters=10, eps=1e-6):\n",
    "    sk_prob = soft_skel(prob, iters=iters)\n",
    "    sk_gt = soft_skel(gt, iters=iters)\n",
    "    dims = (1, 2, 3)\n",
    "    tprec = (sk_prob * gt).sum(dims) / (sk_prob.sum(dims) + eps)\n",
    "    tsens = (sk_gt * prob).sum(dims) / (sk_gt.sum(dims) + eps)\n",
    "    cl = 1.0 - (2.0 * tprec * tsens) / (tprec + tsens + eps)\n",
    "    return cl.mean()\n",
    "\n",
    "\n",
    "class CableLoss(nn.Module):\n",
    "    def __init__(\n",
    "        self,\n",
    "        alpha=0.3,\n",
    "        beta=0.7,\n",
    "        w_tversky=1.0,\n",
    "        w_cldice=0.25,\n",
    "        w_morph=0.20,\n",
    "        w_boundary=0.08,\n",
    "        w_empty=0.35,\n",
    "        skel_iters=10,\n",
    "        pos_weight=3.0,\n",
    "        w_skel_bce=0.20,\n",
    "        skel_bce_mult=4.0,\n",
    "        focal_gamma=0.0,\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        self.tversky = smp.losses.TverskyLoss(\n",
    "            mode=\"binary\",\n",
    "            from_logits=True,\n",
    "            alpha=alpha,\n",
    "            beta=beta,\n",
    "            smooth=1.0,\n",
    "        )\n",
    "\n",
    "        self.w_tversky = float(w_tversky)\n",
    "        self.w_cldice = float(w_cldice)\n",
    "        self.w_morph = float(w_morph)\n",
    "        self.w_boundary = float(w_boundary)\n",
    "        self.w_empty = float(w_empty)\n",
    "        self.skel_iters = int(skel_iters)\n",
    "\n",
    "        self.w_skel_bce = float(w_skel_bce)\n",
    "        self.skel_bce_mult = float(skel_bce_mult)\n",
    "        self.focal_gamma = float(focal_gamma)\n",
    "\n",
    "        self.register_buffer(\"pos_weight\", torch.tensor([float(pos_weight)], dtype=torch.float32))\n",
    "\n",
    "        sobel_x = torch.tensor([[1, 0, -1], [2, 0, -2], [1, 0, -1]], dtype=torch.float32).view(1, 1, 3, 3)\n",
    "        sobel_y = sobel_x.transpose(2, 3)\n",
    "        self.register_buffer(\"sobel_x\", sobel_x)\n",
    "        self.register_buffer(\"sobel_y\", sobel_y)\n",
    "\n",
    "    def morph_loss(self, prob, target, eps=1e-6):\n",
    "        dil_h = F.max_pool2d(prob, (1, 9), 1, (0, 4))\n",
    "        dil_v = F.max_pool2d(prob, (9, 1), 1, (4, 0))\n",
    "        dil = torch.max(dil_h, dil_v)\n",
    "\n",
    "        dims = (1, 2, 3)\n",
    "        inter = (dil * target).sum(dims)\n",
    "        union = dil.sum(dims) + target.sum(dims)\n",
    "        return (1.0 - (2.0 * inter / (union + eps))).mean()\n",
    "\n",
    "    def boundary_loss(self, prob, target):\n",
    "        prob = prob.float()\n",
    "        target = target.float()\n",
    "        edge_p = torch.abs(F.conv2d(prob, self.sobel_x, padding=1)) + torch.abs(F.conv2d(prob, self.sobel_y, padding=1))\n",
    "        edge_g = torch.abs(F.conv2d(target, self.sobel_x, padding=1)) + torch.abs(F.conv2d(target, self.sobel_y, padding=1))\n",
    "        return F.l1_loss(edge_p, edge_g)\n",
    "\n",
    "    def bce_logits(self, logits, target):\n",
    "        pw = self.pos_weight.to(device=logits.device, dtype=logits.dtype)\n",
    "        return F.binary_cross_entropy_with_logits(logits, target, pos_weight=pw)\n",
    "\n",
    "    def weighted_bce_logits(self, logits, target, weight_map):\n",
    "        pw = self.pos_weight.to(device=logits.device, dtype=logits.dtype)\n",
    "        bce = F.binary_cross_entropy_with_logits(logits, target, pos_weight=pw, reduction=\"none\")\n",
    "\n",
    "        if self.focal_gamma > 0:\n",
    "            p = torch.sigmoid(logits).clamp(1e-6, 1 - 1e-6)\n",
    "            pt = torch.where(target > 0.5, p, 1.0 - p)\n",
    "            bce = bce * ((1.0 - pt) ** self.focal_gamma)\n",
    "\n",
    "        return (bce * weight_map).mean()\n",
    "\n",
    "    def forward(self, logits, target):\n",
    "        target = target.to(device=logits.device, dtype=torch.float32)\n",
    "\n",
    "        target_sum = target.flatten(1).sum(dim=1)\n",
    "        empty = (target_sum == 0)\n",
    "\n",
    "        if empty.all():\n",
    "            zeros = torch.zeros_like(target)\n",
    "            return self.w_empty * self.bce_logits(logits, zeros)\n",
    "\n",
    "        tversky = self.tversky(logits, target)\n",
    "        prob = torch.sigmoid(logits).float()\n",
    "\n",
    "        morph = self.morph_loss(prob, target)\n",
    "\n",
    "        with torch.amp.autocast(device_type=logits.device.type, enabled=False):\n",
    "            boundary = self.boundary_loss(prob, target)\n",
    "\n",
    "        cld = cldice_loss(prob, target, iters=self.skel_iters)\n",
    "\n",
    "        sk_gt = soft_skel(target, iters=self.skel_iters).detach()\n",
    "        wmap = 1.0 + self.skel_bce_mult * sk_gt\n",
    "        sk_bce = self.weighted_bce_logits(logits, target, wmap)\n",
    "\n",
    "        total = (\n",
    "            self.w_tversky * tversky\n",
    "            + self.w_cldice * cld\n",
    "            + self.w_morph * morph\n",
    "            + self.w_boundary * boundary\n",
    "            + self.w_skel_bce * sk_bce\n",
    "        )\n",
    "\n",
    "        if empty.any():\n",
    "            zeros_e = torch.zeros_like(target[empty])\n",
    "            empty_loss = self.bce_logits(logits[empty], zeros_e)\n",
    "            total = total + (self.w_empty * 0.10) * empty_loss\n",
    "\n",
    "        return total\n"
   ]
