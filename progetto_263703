    "\n",
    "def count_junctions(sk_uint8):\n",
    "    k = np.ones((3, 3), np.uint8)\n",
    "    n = cv2.filter2D(sk_uint8.astype(np.uint8), -1, k)\n",
    "    return int(np.sum((sk_uint8 > 0) & (n >= 5)))\n",
    "\n",
    "def angle_diff_pi(a, b):\n",
    "    d = abs(a - b) % math.pi\n",
    "    return min(d, math.pi - d)\n",
    "\n",
    "def bbox_from_mask(mask_uint8):\n",
    "    ys, xs = np.where(mask_uint8 > 0)\n",
    "    if xs.size == 0:\n",
    "        return None\n",
    "    x_min, x_max = xs.min(), xs.max()\n",
    "    y_min, y_max = ys.min(), ys.max()\n",
    "    return [float(x_min), float(y_min), float(x_max - x_min + 1), float(y_max - y_min + 1)]\n",
    "\n",
    "def rle_encode(mask_uint8):\n",
    "    m = np.asfortranarray(mask_uint8.astype(np.uint8))\n",
    "    rle = maskUtils.encode(m)\n",
    "    rle[\"counts\"] = rle[\"counts\"].decode(\"utf-8\")\n",
    "    return rle\n",
    "\n",
    "def mask_iou(m1, m2):\n",
    "    inter = np.logical_and(m1 > 0, m2 > 0).sum()\n",
    "    union = np.logical_or(m1 > 0, m2 > 0).sum()\n",
    "    return float(inter / max(1, union))\n",
    "\n",
    "def get_line_params_from_skel(skel_bool, W, H):\n",
    "    ys, xs = np.where(skel_bool)\n",
    "    if xs.size < 10:\n",
    "        return None\n",
    "    pts = np.column_stack((xs, ys)).astype(np.float32)\n",
    "    if pts.shape[0] > 20:\n",
    "        mean = pts.mean(axis=0)\n",
    "        d = np.linalg.norm(pts - mean, axis=1)\n",
    "        keep = d < np.percentile(d, 85)\n",
    "        pts = pts[keep]\n",
    "        if pts.shape[0] < 10:\n",
    "            return None\n",
    "    pts[:, 0] -= W / 2.0\n",
    "    pts[:, 1] -= H / 2.0\n",
    "    vx, vy, x0, y0 = cv2.fitLine(pts, cv2.DIST_L2, 0, 0.01, 0.01)\n",
    "    vx, vy, x0, y0 = [float(v.item()) for v in (vx, vy, x0, y0)]\n",
    "    phi = math.atan2(vy, vx)\n",
    "    theta = (phi + math.pi / 2.0) % math.pi\n",
    "    rho = x0 * math.cos(theta) + y0 * math.sin(theta)\n",
    "    return float(rho), float(theta)\n",
    "\n",
    "def build_work_mask(prob_map):\n",
    "    p80 = float(np.percentile(prob_map, 80))\n",
    "    mult = 0.85 if p80 > 0.18 else 0.78\n",
    "    floor = THR * (0.80 if p80 < 0.16 else 0.90)\n",
    "    thr_img = max(floor, p80 * mult)\n",
    "\n",
    "    strong = (prob_map > thr_img).astype(np.uint8)\n",
    "    weak_thr = float(thr_img * HYST_REL)\n",
    "    weak = (prob_map > weak_thr).astype(np.uint8)\n",
    "\n",
    "    num, lab, stats, _ = cv2.connectedComponentsWithStats(weak, connectivity=8)\n",
    "    out = np.zeros_like(weak, dtype=np.uint8)\n",
    "\n",
    "    for cid in range(1, num):\n",
    "        comp = (lab == cid)\n",
    "        if strong[comp].any():\n",
    "            out[comp] = 1\n",
    "        else:\n",
    "            area = stats[cid, cv2.CC_STAT_AREA]\n",
    "            pix = prob_map[comp]\n",
    "            if pix.size > 0:\n",
    "                p95 = float(np.percentile(pix, 95))\n",
    "                mean = float(pix.mean())\n",
    "                if area >= max(AREA_MIN, 10) and (p95 > thr_img * 0.95 or mean > weak_thr * 1.02):\n",
    "                    out[comp] = 1\n",
    "\n",
    "    if KERNEL_CLOSE > 1:\n",
    "        out = cv2.morphologyEx(out, cv2.MORPH_CLOSE, kernel_close)\n",
    "\n",
    "    return out, float(thr_img)\n",
    "\n",
    "def thin_output_from_component(single_uint8, prob_map, thr_img, is_small):\n",
    "    sk_in = skeletonize(single_uint8 > 0)\n",
    "    skel_len = int(sk_in.sum())\n",
    "    area = int(single_uint8.sum())\n",
    "    if skel_len < 10:\n",
    "        return None, skel_len\n",
    "\n",
    "    thick = float(area / max(1, skel_len))\n",
    "    r_from_thick = thick / THICK_SCALE\n",
    "\n",
    "    dist = cv2.distanceTransform(single_uint8.astype(np.uint8), cv2.DIST_L2, 3)\n",
    "    vals = dist[sk_in]\n",
    "    if vals.size > 0:\n",
    "        r_from_dt = float(np.median(vals) * DIST_ALPHA)\n",
    "        r_est = 0.35 * r_from_thick + 0.65 * r_from_dt\n",
    "    else:\n",
    "        r_est = r_from_thick\n",
    "\n",
    "    rmax = R_MAX_SMALL if is_small else R_MAX_BIG\n",
    "    r = int(np.clip(round(r_est), R_MIN, rmax))\n",
    "\n",
    "    k = 2 * r + 1\n",
    "    ker = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k, k))\n",
    "\n",
    "    out = cv2.dilate(sk_in.astype(np.uint8), ker, iterations=1)\n",
    "\n",
    "    gate_rel = GATE_REL_SMALL if is_small else GATE_REL_BIG\n",
    "    pix = prob_map[single_uint8 == 1]\n",
    "    local = float(np.percentile(pix, 60)) * LOCAL_P60_MUL if pix.size > 0 else 0.0\n",
    "    gate_thr = max(float(thr_img * gate_rel), local)\n",
    "\n",
    "    gate_lo = (prob_map > (gate_thr * GATE_LO_MUL)).astype(np.uint8)\n",
    "    gate_hi = (prob_map > (gate_thr * GATE_HI_MUL)).astype(np.uint8)\n",
    "\n",
    "    out = (out & gate_lo) | (single_uint8 & gate_hi)\n",
    "    out = cv2.morphologyEx(out.astype(np.uint8), cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n",
    "\n",
    "    if out.sum() < max(8, int(0.40 * skel_len)):\n",
    "        out = cv2.dilate(sk_in.astype(np.uint8), ker, iterations=2)\n",
    "        out = (out & gate_lo) | (single_uint8 & gate_hi)\n",
    "        out = cv2.morphologyEx(out.astype(np.uint8), cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n",
    "\n",
    "    return out.astype(np.uint8), skel_len\n",
    "\n",
    "def split_component_hough(single_uint8, hough_th=60, dbscan_eps=0.20, width_mul=2.0):\n",
    "    sk = skeletonize(single_uint8 > 0).astype(np.uint8)\n",
    "    if sk.sum() < 10:\n",
    "        return [single_uint8]\n",
    "\n",
    "    lines = cv2.HoughLines(sk * 255, rho=1, theta=np.pi / 180, threshold=int(hough_th))\n",
    "    if lines is None or len(lines) < 2:\n",
    "        return [single_uint8]\n",
    "\n",
    "    params = np.array([l[0] for l in lines])\n",
    "\n",
    "    X = np.stack([\n",
    "        params[:, 0] / 40.0,\n",
    "        np.cos(2 * params[:, 1]),\n",
    "        np.sin(2 * params[:, 1]),\n",
    "    ], axis=1)\n",
    "\n",
    "    lab = DBSCAN(eps=float(dbscan_eps), min_samples=2).fit(X).labels_\n",
    "\n",
    "    unique_labs = set(lab)\n",
    "    if len(unique_labs) <= 1 or (len(unique_labs) == 1 and -1 in unique_labs):\n",
    "        return [single_uint8]\n",
    "\n",
    "    ys, xs = np.where(single_uint8 > 0)\n",
    "\n",
    "    dist = cv2.distanceTransform(single_uint8.astype(np.uint8), cv2.DIST_L2, 3)\n",
    "    vals = dist[sk > 0]\n",
    "    base_width = float(np.median(vals)) if vals.size > 0 else 2.0\n",
    "    width = max(2.5, base_width * float(width_mul))\n",
    "\n",
    "    out = []\n",
    "    combined_mask = np.zeros_like(single_uint8)\n",
    "\n",
    "    for c in unique_labs:\n",
    "        if c == -1:\n",
    "            continue\n",
    "\n",
    "        cluster_params = params[lab == c]\n",
    "        rho, theta = np.median(cluster_params, axis=0)\n",
    "\n",
    "        d = np.abs(xs * np.cos(theta) + ys * np.sin(theta) - rho)\n",
    "        keep = d <= width\n",
    "\n",
    "        m = np.zeros_like(single_uint8, dtype=np.uint8)\n",
    "        m[ys[keep], xs[keep]] = 1\n",
    "\n",
    "        if m.sum() > 15:\n",
    "            m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n",
    "            out.append(m)\n",
    "            combined_mask = combined_mask | m\n",
    "\n",
    "    remainder = (single_uint8 > 0) & (combined_mask == 0)\n",
    "    if remainder.any() and len(out) > 0:\n",
    "        out[0] = out[0] | remainder.astype(np.uint8)\n",
    "\n",
    "    return out if len(out) >= 2 else [single_uint8]\n",
    "\n",
    "def skel_linearity(sk_bool):\n",
    "    pts = np.column_stack(np.where(sk_bool))\n",
    "    if pts.shape[0] < 12:\n",
    "        return 0.0\n",
    "    mean = pts.mean(axis=0)\n",
    "    cov = np.cov((pts - mean).T)\n",
    "    eig = np.linalg.eigvalsh(cov)\n",
    "    l1, l2 = float(eig[-1]), float(eig[0])\n",
    "    return l1 / (l1 + l2 + 1e-8)\n",
    "\n",
    "def line_nms(objs, max_keep):\n",
    "    if not objs:\n",
    "        return objs\n",
    "\n",
    "    objs = sorted(objs, key=lambda o: o[\"score\"], reverse=True)\n",
    "    keep = []\n",
    "\n",
    "    IOU_STRONG_DUP = max(0.85, float(MASK_IOU_NMS) + 0.20)\n",
    "    THETA_DUP = float(THETA_NMS) * 1.6\n",
    "    RHO_DUP = float(RHO_NMS) * 1.3\n",
    "\n",
    "    for o in objs:\n",
    "        dup = False\n",
    "        for k in keep:\n",
    "            iou = mask_iou(o[\"mask\"], k[\"mask\"])\n",
    "            if iou >= IOU_STRONG_DUP:\n",
    "                dup = True\n",
    "                break\n",
    "            if iou >= MASK_IOU_NMS:\n",
    "                if angle_diff_pi(o[\"theta\"], k[\"theta\"]) < THETA_DUP and abs(o[\"rho\"] - k[\"rho\"]) < RHO_DUP:\n",
    "                    dup = True\n",
    "                    break\n",
    "        if not dup:\n",
    "            keep.append(o)\n",
    "            if len(keep) >= max_keep:\n",
    "                break\n",
    "\n",
    "    return keep\n",
    "\n",
    "def select_diverse_topk(objs, k=10, theta_thr=0.012, rho_thr=7.0, iou_thr=0.35):\n",
    "    if not objs:\n",
    "        return []\n",
    "    objs = sorted(objs, key=lambda o: o[\"score\"], reverse=True)\n",
    "    keep = []\n",
    "    for o in objs:\n",
    "        ok = True\n",
    "        for q in keep:\n",
    "            if angle_diff_pi(o[\"theta\"], q[\"theta\"]) < float(theta_thr) and abs(o[\"rho\"] - q[\"rho\"]) < float(rho_thr):\n",
    "                ok = False\n",
    "                break\n",
    "            if mask_iou(o[\"mask\"], q[\"mask\"]) > float(iou_thr):\n",
    "                ok = False\n",
    "                break\n",
    "        if ok:\n",
    "            keep.append(o)\n",
    "            if len(keep) >= int(k):\n",
    "                break\n",
    "    return keep\n",
    "\n",
    "def score_component_from_skel(prob_map, single, out_mask, sk_out_bool, mean_score, p95_score):\n",
    "    skel_len = int(sk_out_bool.sum())\n",
    "    if skel_len == 0:\n",
    "        return 0.0\n",
    "\n",
    "    sk_pix = prob_map[sk_out_bool]\n",
    "    sk_p95 = float(np.percentile(sk_pix, 95)) if sk_pix.size else p95_score\n",
    "    sk_p99 = float(np.percentile(sk_pix, 99)) if sk_pix.size else sk_p95\n",
    "    sk_mean = float(sk_pix.mean()) if sk_pix.size else mean_score\n",
    "\n",
    "    lin = skel_linearity(sk_out_bool)\n",
    "    junc = count_junctions(sk_out_bool.astype(np.uint8))\n",
    "\n",
    "    mask_pix = prob_map[out_mask > 0]\n",
    "    mask_p90 = float(np.percentile(mask_pix, 90)) if mask_pix.size else p95_score\n",
    "    mask_mean = float(mask_pix.mean()) if mask_pix.size else mean_score\n",
    "\n",
    "    len_boost = 0.60 + 0.40 * float(np.tanh(skel_len / 90.0))\n",
    "    base = (\n",
    "        0.36 * sk_p95 +\n",
    "        0.10 * sk_p99 +\n",
    "        0.20 * sk_mean +\n",
    "        0.22 * mask_p90 +\n",
    "        0.12 * mask_mean\n",
    "    )\n",
    "    junc_pen = 1.0 / (1.0 + 0.45 * junc)\n",
    "    s = base * len_boost * (0.60 + 0.40 * lin) * junc_pen\n",
    "    return float(np.clip(s, 0.01, 0.99))\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_prob_tta(model, images, scales=(1.0, 1.25, 1.5, 2.0), do_flip=False, div=32):\n",
    "    device_ = images.device\n",
    "    B, C, H, W = images.shape\n",
    "    probs_list = []\n",
    "\n",
    "    def pad_to_divisible(x, div=32):\n",
    "        _, _, h, w = x.shape\n",
    "        pad_h = (div - h % div) % div\n",
    "        pad_w = (div - w % div) % div\n",
    "        pad = (0, pad_w, 0, pad_h)\n",
    "        x_pad = F.pad(x, pad, mode=\"reflect\")\n",
    "        return x_pad, pad\n",
    "\n",
    "    def unpad(x, pad):\n",
    "        _, pad_w, _, pad_h = pad\n",
    "        if pad_h > 0:\n",
    "            x = x[:, :, :-pad_h, :]\n",
    "        if pad_w > 0:\n",
    "            x = x[:, :, :, :-pad_w]\n",
    "        return x\n",
    "\n",
    "    for s in scales:\n",
    "        if s == 1.0:\n",
    "            imgs_s = images\n",
    "        else:\n",
    "            h2 = int(round(H * s))\n",
    "            w2 = int(round(W * s))\n",
    "            imgs_s = F.interpolate(images, size=(h2, w2), mode=\"bilinear\", align_corners=False)\n",
    "\n",
    "        imgs_pad, pad = pad_to_divisible(imgs_s, div=div)\n",
    "\n",
    "        with torch.amp.autocast(device_type=device_.type, enabled=(device_.type == \"cuda\")):\n",
    "            logits = model(imgs_pad)\n",
    "            probs = torch.sigmoid(logits).float()\n",
    "\n",
    "        probs = unpad(probs, pad)\n",
    "        if probs.shape[-2:] != (H, W):\n",
    "            probs = F.interpolate(probs, size=(H, W), mode=\"bilinear\", align_corners=False)\n",
    "\n",
    "        probs_list.append(probs)\n",
    "\n",
    "        if do_flip:\n",
    "            imgs_f = torch.flip(imgs_s, dims=[3])\n",
    "            imgs_f, pad_f = pad_to_divisible(imgs_f, div=div)\n",
    "\n",
    "            with torch.amp.autocast(device_type=device_.type, enabled=(device_.type == \"cuda\")):\n",
    "                logits_f = model(imgs_f)\n",
    "                probs_f = torch.sigmoid(logits_f).float()\n",
    "\n",
    "            probs_f = unpad(probs_f, pad_f)\n",
    "            probs_f = torch.flip(probs_f, dims=[3])\n",
    "            if probs_f.shape[-2:] != (H, W):\n",
    "                probs_f = F.interpolate(probs_f, size=(H, W), mode=\"bilinear\", align_corners=False)\n",
    "\n",
    "            probs_list.append(probs_f)\n",
    "\n",
    "    stack = torch.stack(probs_list, dim=0)\n",
    "    prob_med = stack.median(dim=0).values\n",
    "    return prob_med\n",
    "\n",
    "@torch.no_grad()\n",
    "def make_predictions_json_unetpp_lds(\n",
    "    model_unetpp,\n",
    "    test_loader,\n",
    "    test_img_meta,\n",
    "    pred_category_id,\n",
    "    out_path=\"pred_unetpp_lds.json\",\n",
    "    desc=\"Inference UNet++ (LDS+) - V3.3\",\n",
    "    tta_scales=(0.75, 1.0, 1.25),\n",
    "    do_flip=True,\n",
    "    max_images=None,\n",
    "    topk_min=TOPK_MIN,\n",
    "    topk_max=TOPK_MAX,\n",
    "    max_out_per_img=MAX_OUT_PER_IMG,\n",
    "    img_ids=None,\n",
    "):\n",
    "    model_unetpp.eval()\n",
    "    predictions = []\n",
    "    prediction_id = 0\n",
    "    img_id_set = set(map(int, img_ids)) if img_ids is not None else None\n",
    "    n_img = 0\n",
    "\n",
    "    for images, image_ids in tqdm(test_loader, desc=desc):\n",
    "        if img_id_set is not None:\n",
    "            batch_ids = [int(x.item()) for x in image_ids]\n",
    "            if not any(i in img_id_set for i in batch_ids):\n",
    "                continue\n",
    "\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        probs = predict_prob_tta(model_unetpp, images, scales=tta_scales, do_flip=do_flip)\n",
    "        probs = torch.nan_to_num(probs, nan=0.0, posinf=1.0, neginf=0.0).clamp_(0.0, 1.0)\n",
    "\n",
    "        for i in range(len(image_ids)):\n",
    "            img_id = int(image_ids[i].item())\n",
    "            if img_id_set is not None and img_id not in img_id_set:\n",
    "                continue\n",
    "\n",
    "            meta = test_img_meta.get(img_id, None)\n",
    "            W = int(meta.get(\"width\", 700)) if meta else 700\n",
    "            H = int(meta.get(\"height\", 700)) if meta else 700\n",
    "\n",
    "            prob_map = probs[i, 0].float().cpu().numpy()\n",
    "            prob_map = cv2.resize(prob_map.astype(np.float32), (W, H), interpolation=cv2.INTER_LINEAR)\n",
    "\n",
    "            if not np.isfinite(prob_map).all():\n",
    "                prob_map = np.nan_to_num(prob_map, nan=0.0, posinf=1.0, neginf=0.0)\n",
    "            prob_map = np.clip(prob_map, 0.0, 1.0)\n",
    "\n",
    "            mean_p = float(prob_map.mean()) if np.isfinite(prob_map.mean()) else 0.0\n",
    "            topk_img = int(topk_min + (topk_max - topk_min) * np.clip(mean_p / TOPK_MEAN_REF, 0, 1))\n",
    "            topk_img = max(topk_min, min(topk_img, topk_max))\n",
    "\n",
    "            mask, thr_img = build_work_mask(prob_map)\n",
    "            num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)\n",
    "            if num_labels <= 1:\n",
    "                n_img += 1\n",
    "                if (max_images is not None) and (n_img >= int(max_images)):\n",
    "                    with open(out_path, \"w\") as f:\n",
    "                        json.dump(predictions, f)\n",
    "                    return out_path\n",
    "                continue\n",
    "\n",
    "            cand = []\n",
    "            for cid in range(1, num_labels):\n",
    "                area = float(stats[cid, cv2.CC_STAT_AREA])\n",
    "                if area < 4:\n",
    "                    continue\n",
    "                pix = prob_map[labels == cid]\n",
    "                if pix.size == 0:\n",
    "                    continue\n",
    "                mean_s = float(pix.mean())\n",
    "                p95_s = float(np.percentile(pix, 95))\n",
    "                p99_s = float(np.percentile(pix, 99))\n",
    "                cheap = 0.75 * p95_s + 0.15 * p99_s + 0.10 * mean_s + 0.02 * math.log1p(area)\n",
    "                cand.append((cheap, cid))\n",
    "\n",
    "            if not cand:\n",
    "                n_img += 1\n",
    "                if (max_images is not None) and (n_img >= int(max_images)):\n",
    "                    with open(out_path, \"w\") as f:\n",
    "                        json.dump(predictions, f)\n",
    "                    return out_path\n",
    "                continue\n",
    "\n",
    "            cand.sort(reverse=True, key=lambda x: x[0])\n",
    "            comp_ids = [cid for _, cid in cand[:topk_img]]\n",
    "\n",
    "            img_objs = []\n",
    "            for label_idx in comp_ids:\n",
    "                single_full = (labels == label_idx).astype(np.uint8)\n",
    "                area_full = int(single_full.sum())\n",
    "                if area_full == 0:\n",
    "                    continue\n",
    "\n",
    "                sk_tmp = skeletonize(single_full > 0)\n",
    "                lin_tmp = skel_linearity(sk_tmp)\n",
    "                junc_tmp = count_junctions(sk_tmp.astype(np.uint8))\n",
    "\n",
    "                sub_masks = [single_full]\n",
    "                if area_full >= SPLIT_AREA and (lin_tmp < 0.90 or junc_tmp >= 2):\n",
    "                    sub_masks = split_component_hough(\n",
    "                        single_full,\n",
    "                        hough_th=HOUGH_TH,\n",
    "                        dbscan_eps=DBSCAN_EPS,\n",
    "                        width_mul=WIDTH_MUL,\n",
    "                    )\n",
    "\n",
    "                for single in sub_masks:\n",
    "                    area = int(single.sum())\n",
    "                    if area == 0:\n",
    "                        continue\n",
    "\n",
    "                    if area < SMALL_AREA:\n",
    "                        area_min = 4\n",
    "                        min_skel_len = 12\n",
    "                        mean_min = 0.07\n",
    "                        p95_min = 0.18\n",
    "                    else:\n",
    "                        area_min = AREA_MIN\n",
    "                        min_skel_len = MIN_SKEL_LEN\n",
    "                        mean_min = MEAN_MIN\n",
    "                        p95_min = P95_MIN\n",
    "\n",
    "                    if area < area_min:\n",
    "                        continue\n",
    "\n",
    "                    pix = prob_map[single == 1]\n",
    "                    if pix.size == 0:\n",
    "                        continue\n",
    "\n",
    "                    mean_score = float(pix.mean())\n",
    "                    p95_score = float(np.percentile(pix, 95))\n",
    "                    if (mean_score < mean_min) and (p95_score < p95_min):\n",
    "                        continue\n",
    "\n",
    "                    is_small = (area < SMALL_AREA)\n",
    "                    out_mask, skel_len_in = thin_output_from_component(single, prob_map, thr_img, is_small=is_small)\n",
    "                    if out_mask is None:\n",
    "                        continue\n",
    "\n",
    "                    if skel_len_in < min_skel_len and p95_score < (p95_min + 0.03):\n",
    "                        continue\n",
    "\n",
    "                    sk_out = skeletonize(out_mask > 0)\n",
    "                    line = get_line_params_from_skel(sk_out, W=W, H=H)\n",
    "                    if line is None:\n",
    "                        continue\n",
    "\n",
    "                    rho, theta = line\n",
    "                    bbox = bbox_from_mask(out_mask)\n",
    "                    if bbox is None:\n",
    "                        continue\n",
    "\n",
    "                    score = score_component_from_skel(prob_map, single, out_mask, sk_out, mean_score, p95_score)\n",
    "                    if score < SCORE_MIN:\n",
    "                        continue\n",
    "\n",
    "                    img_objs.append({\n",
    "                        \"mask\": out_mask,\n",
    "                        \"bbox\": bbox,\n",
    "                        \"rho\": rho,\n",
    "                        \"theta\": theta,\n",
    "                        \"score\": score,\n",
    "                    })\n",
    "\n",
    "            if not img_objs:\n",
    "                n_img += 1\n",
    "                if (max_images is not None) and (n_img >= int(max_images)):\n",
    "                    with open(out_path, \"w\") as f:\n",
    "                        json.dump(predictions, f)\n",
    "                    return out_path\n",
    "                continue\n",
    "\n",
    "            img_objs = line_nms(img_objs, max_keep=max_out_per_img)\n",
    "            img_objs = sorted(img_objs, key=lambda o: o[\"score\"], reverse=True)\n",
    "\n",
    "            top10_div = select_diverse_topk(img_objs, k=10, theta_thr=0.013, rho_thr=7.5, iou_thr=0.45)\n",
    "            top10_ids = set(id(o) for o in top10_div)\n",
    "            rest = [o for o in img_objs if id(o) not in top10_ids]\n",
    "            img_objs = (top10_div + rest)[:max_out_per_img]\n",
    "\n",
    "            for o in img_objs:\n",
    "                predictions.append({\n",
    "                    \"image_id\": img_id,\n",
    "                    \"category_id\": int(pred_category_id),\n",
    "                    \"bbox\": o[\"bbox\"],\n",
    "                    \"segmentation\": rle_encode(o[\"mask\"]),\n",
    "                    \"score\": float(o[\"score\"]),\n",
    "                    \"lines\": [float(o[\"rho\"]), float(o[\"theta\"])],\n",
    "                    \"id\": prediction_id,\n",
    "                })\n",
    "                prediction_id += 1\n",
    "\n",
    "            n_img += 1\n",
    "            if (max_images is not None) and (n_img >= int(max_images)):\n",
    "                with open(out_path, \"w\") as f:\n",
    "                    json.dump(predictions, f)\n",
    "                return out_path\n",
    "\n",
    "    with open(out_path, \"w\") as f:\n",
    "        json.dump(predictions, f)\n",
    "    return out_path\n"
