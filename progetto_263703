    "            bgr = cv2.imread(r[\"img_path\"], cv2.IMREAD_COLOR)\n",
    "            if bgr is not None:\n",
    "                img_rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)\n",
    "        if img_rgb is None:\n",
    "            img_rgb = np.zeros((H, W, 3), dtype=np.uint8)\n",
    "\n",
    "        gt_union = np.zeros((H, W), np.uint8)\n",
